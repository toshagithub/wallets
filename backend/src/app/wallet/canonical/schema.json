{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallets.local/schemas/canonical-ticket.schema.json",
  "title": "Canonical Ticket",
  "description": "Platform-independent canonical data model for a digital event ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass",
    "tenant",
    "event",
    "holder",
    "ticket_type",
    "visual",
    "meta"
  ],
  "properties": {
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serial_number"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "serial_number": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "starts_at",
        "ends_at",
        "location"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "ticket_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo_text",
        "foreground_color",
        "background_color"
      ],
      "properties": {
        "logo_text": {
          "type": "string",
          "minLength": 1
        },
        "foreground_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        }
      }
    }
  }
}
